# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI & Outreach (Sandbox Dispatch by Default)
GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=re_your_resend_api_key
ENABLE_REAL_EMAIL_SENDING=false

# Webhook & API Security
WEBHOOK_SECRET=your-svix-or-hmac-webhook-secret
API_SECRET_KEY=your-api-secret-key-for-ingest-and-acquire
CRON_SECRET=your-vercel-cron-secret

# Portfolio Sandbox Mode (set to "true" to lock private deployments)
DISABLE_DEMO_MODE=false

# Sender Identity & Compliance
SENDER_NAME="Lead Intelligence Team"
BUSINESS_NAME="Lead Intelligence Platform"
BUSINESS_ADDRESS="San Francisco, CA"
APP_BASE_URL="http://localhost:3000"
PRIVACY_NOTICE_URL="http://localhost:3000/privacy"
UNSUBSCRIBE_SECRET="your_random_unsubscribe_secret_at_least_32_chars_long"
